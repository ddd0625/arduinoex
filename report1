const int LED_PIN = 7;
int pwm_period = 1000;   
int pwm_duty = 0;       

void set_period(int period) {
  if (period < 100) {
    period = 100;
  }

  if (period > 10000) {
    period = 10000;
  }

  pwm_period = period;
}

void set_duty(int duty) {
  if (duty < 0) {
    duty = 0;
  }

  if (duty > 100) {
    duty = 100;
  }

  pwm_duty = duty;
}

void pwm_output() {

  int high_time;
  int low_time;

  high_time = (long)pwm_period * pwm_duty / 100;
  low_time = pwm_period - high_time;

  if (pwm_duty == 0) {
    digitalWrite(LED_PIN, LOW);
    delayMicroseconds(pwm_period);
  }
  else if (pwm_duty == 100) {
    digitalWrite(LED_PIN, HIGH);
    delayMicroseconds(pwm_period);
  }
 else {
    digitalWrite(LED_PIN, HIGH);
    delayMicroseconds(high_time);

    digitalWrite(LED_PIN, LOW);
    delayMicroseconds(low_time);
  }
}
void setup() {

  pinMode(LED_PIN, OUTPUT);

  set_period(100); 
}
void loop() {
  int total_cycles = 1000000L / pwm_period;
  for (int i = 0; i < total_cycles; i++) {

    int duty;
if (i < total_cycles / 2) {

      duty = (long)i * 200 / total_cycles;
    }
    else {

      duty = 200 - ((long)i * 200 / total_cycles);
    }
    set_duty(duty);
    pwm_output();
  }
}
